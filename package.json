{
  "name": "dsh-tavern-comfy",
  "version": "1.2.0",
  "description": "本地 ComfyUI 场景生图：每轮自动出图、图片内联插在正文段落之间、工作流库与人物库自带控制台。",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "console.html",
    "design-rules.md",
    "世界书-通用生图规则.json",
    "workflows/.gitkeep",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8 <0.2.0"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-tavern",
    "comfyui",
    "stable-diffusion",
    "text-to-image",
    "tavern",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/weixinlll/dsh-tavern-comfy.git"
  },
  "homepage": "https://github.com/weixinlll/dsh-tavern-comfy#readme",
  "bugs": {
    "url": "https://github.com/weixinlll/dsh-tavern-comfy/issues"
  },
  "author": ""
}
